.step h3{color:var(--navy);margin-bottom:6px}.step p{color:var(--muted);font-size:14px}
.band{background:linear-gradient(135deg,var(--purple),var(--navy));color:#fff;border-radius:22px;padding:50px;display:flex;justify-content:space-between;align-items:center;gap:30px;flex-wrap:wrap}
.band h2{font-size:30px}.band p{color:#DDD6FE}
.infra{background:var(--navy);color:#CBD5E1;border-radius:14px;padding:22px 26px;margin-top:40px;font-size:14px;display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
.infra div b{display:block;color:var(--orange);font-size:12px;text-transform:uppercase;letter-spacing:1px}
.infra code{color:#fff;font-family:Consolas,monospace}
footer{background:var(--navy);color:#94A3B8;padding:40px 0;font-size:13px;text-align:center}
