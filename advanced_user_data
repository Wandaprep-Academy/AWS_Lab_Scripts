  <p style="margin-top:6px">Served by Apache on Amazon EC2 · Built for <span class="wp">WandaPrep Academy</span> · wandaprepacademy.com</p>
</div></footer>

<script>
const $=id=>document.getElementById(id),gbp=n=>'£'+Math.round(n).toLocaleString('en-GB');
function calc(){
  const p=+$('price').value,d=Math.min(+$('dep').value,p),r=+$('rate').value/1200,n=+$('term').value*12,loan=p-d;
  const pay=r?loan*r/(1-Math.pow(1+r,-n)):loan/n;
  $('pv').textContent=gbp(p);$('dv').textContent=gbp(d);$('rv').textContent=(+$('rate').value).toFixed(2)+'%';$('tv').textContent=$('term').value+' years';
  $('pay').textContent=gbp(pay);$('ltv').textContent='Loan '+gbp(loan)+' · LTV '+(p?Math.round(loan/p*100):0)+'%';
}
['price','dep','rate','term'].forEach(i=>$(i).addEventListener('input',calc));calc();
</script>
</body>
</html>
EOF

# --- Inject instance metadata into the page ---------------------------
sed -i -e "s|__INSTANCE_ID__|${INSTANCE_ID}|" \
       -e "s|__AZ__|${AZ}|" \
       -e "s|__INSTANCE_TYPE__|${INSTANCE_TYPE}|" \
       -e "s|__PRIVATE_IP__|${PRIVATE_IP}|" /var/www/html/index.html

chown apache:apache /var/www/html/index.html
systemctl restart httpd
