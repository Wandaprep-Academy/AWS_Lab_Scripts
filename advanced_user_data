#!/bin/bash
# =====================================================================
#  WandaPrep Academy - EC2 Lab
#  AcmeBank (fictional) - Customer Mortgage Landing Page
#  Amazon Linux 2023 user data: installs Apache and publishes the page
# =====================================================================
set -euxo pipefail

# --- Install and start Apache -----------------------------------------
dnf update -y
dnf install -y httpd
systemctl enable --now httpd

# --- Instance metadata (IMDSv2) - shown on the page for lab demos -----
TOKEN=$(curl -s -X PUT "http://169.254.169.254/latest/api/token" \
  -H "X-aws-ec2-metadata-token-ttl-seconds: 21600" || true)
md() { curl -s -H "X-aws-ec2-metadata-token: $TOKEN" \
  "http://169.254.169.254/latest/meta-data/$1" || echo "n/a"; }
INSTANCE_ID=$(md instance-id)
AZ=$(md placement/availability-zone)
INSTANCE_TYPE=$(md instance-type)
PRIVATE_IP=$(md local-ipv4)

# --- Landing page ------------------------------------------------------
cat > /var/www/html/index.html <<'EOF'
